GITHUB_TOKEN=""

GITHUB_CLIENT_SECRET=""
GITHUB_CLIENT_KEY=""
AUTH_SECRET=""

POSTGRES_DATABASE=""
POSTGRES_HOST=""
POSTGRES_PASSWORD=""
POSTGRES_USER=""
POSTGRES_PRISMA_URL=""
POSTGRES_URL_NO_SSL=""
POSTGRES_URL_NON_POOLING=""
POSTGRES_URL=""

GOOGLE_GENERATIVE_AI_API_KEY=""

# Next.js and Vercel set NODE_ENV automatically.

GEMINI_CHAT_MODEL="gemini-flash-lite-latest"
CHAT_RPM_LIMIT="10"
CHAT_DAILY_LIMIT="100"

# Base URL of the separate Python service, without an /embed suffix.
# Local: http://127.0.0.1:8000; Vercel: the deployed service HTTPS URL.
EMBEDDING_SERVICE_URL="http://127.0.0.1:8000"
# Generate a private random password and set the same value on both servers.
# python -c "import secrets; print(secrets.token_urlsafe(32))"
# Paste only the generated value, without a Bearer prefix.
EMBEDDING_SERVICE_TOKEN=""

# Optional dev-only hostnames, comma-separated, without scheme or port.
# Example for a LAN preview: 192.168.0.14,my-laptop.local
# Leave empty for localhost and omit in Vercel.
DEV_ALLOWED_ORIGINS=""
