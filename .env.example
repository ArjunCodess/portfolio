GITHUB_TOKEN=""

GITHUB_CLIENT_SECRET=""
GITHUB_CLIENT_KEY=""
AUTH_SECRET=""

POSTGRES_DATABASE=""
POSTGRES_HOST=""
POSTGRES_PASSWORD=""
POSTGRES_USER=""
POSTGRES_PRISMA_URL=""
POSTGRES_URL_NO_SSL=""
POSTGRES_URL_NON_POOLING=""
POSTGRES_URL=""

GOOGLE_GENERATIVE_AI_API_KEY=""

# Next.js and Vercel set NODE_ENV automatically.

GEMINI_CHAT_MODEL="gemini-flash-lite-latest"
CHAT_RPM_LIMIT="10"
CHAT_DAILY_LIMIT="100"

# Embeddings use the Gemini API and GOOGLE_GENERATIVE_AI_API_KEY above.
# Refresh pacing counts individual texts, including batched inputs.
EMBEDDING_REFRESH_RPM_LIMIT="80"

# Optional dev-only hostnames, comma-separated, without scheme or port.
# Example for a LAN preview: 192.168.0.14,my-laptop.local
# Leave empty for localhost and omit in Vercel.
DEV_ALLOWED_ORIGINS=""
